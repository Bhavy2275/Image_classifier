# ============================================================
# VisionAI — Environment Variables Example
# Copy this file to .env and fill in your values.
# Never commit .env to git.
# ============================================================

# ----- FastAPI Backend -----
# Origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://your-vercel-app.vercel.app

# Port the API runs on locally
API_PORT=8000

# ----- Supabase -----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# JWT secret for server-side validation (found in Supabase project settings → API)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ----- Cloudinary -----
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_UPLOAD_PRESET=visionai_uploads

# ----- Redis / RQ (batch job queue) -----
REDIS_URL=redis://localhost:6379/0

# ----- ML Model -----
# Path to ONNX model file (generated automatically on first run if not present)
ONNX_MODEL_PATH=model_cache/efficientnet_b0.onnx
# Number of top classes to return
TOP_K=5

# ----- Next.js Frontend -----
# Public API base URL (accessible from browser)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Supabase public keys (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
